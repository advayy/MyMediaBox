{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyMediaBox",
  "version": "1.0.1",
  "identifier": "dev.localtv.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyMediaBox",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://image.tmdb.org data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* ws://127.0.0.1:* https://api.themoviedb.org; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:local_tv_tracker.db"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
